# Salin file ini jadi ".env" lalu sesuaikan isinya

# Koneksi ke database MySQL (XAMPP)
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Default XAMPP: user "root", password kosong
DATABASE_URL="mysql://root:@localhost:3306/absensi_db"

# Port backend berjalan
PORT=5000

# Kunci rahasia untuk membuat token login (JWT). Ganti dengan teks acak apa saja.
JWT_SECRET="ganti_dengan_teks_rahasia_bebas_123!@#"

# Domain email yang diizinkan mendaftar (validasi email kantor)
# Contoh: jika email kantor formatnya nama@pt-maju.com, isi: pt-maju.com
ALLOWED_EMAIL_DOMAIN="contohperusahaan.com"

# Domain frontend yang boleh mengakses API ini (pembatasan CORS).
# Untuk development di localhost/HP di WiFi yang sama, TIDAK perlu diisi
# (sudah otomatis diizinkan). WAJIB diisi saat sudah deploy ke internet,
# dengan domain asli website kamu, contoh:
# FRONTEND_URL="https://absensi.ptzamanteknindo.com"
# Kalau ada beberapa domain, pisahkan dengan koma.
FRONTEND_URL=""
